<Window x:Class="SilkroadAtlas.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Silkroad Atlas" Width="1460" Height="920" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" Icon="Assets/atlas.ico" Style="{StaticResource {x:Type Window}}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101720" BorderBrush="#26323F" BorderThickness="0,0,1,0">
   <DockPanel Margin="20,28,20,20">
    <StackPanel DockPanel.Dock="Top">
     <Grid Margin="9,0,0,32"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="◈" FontSize="34" Foreground="#EFC078"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SILKROAD" FontWeight="Bold" FontSize="17"/><TextBlock Text="A T L A S" FontSize="11" Foreground="#EFC078" Margin="0,2,0,0"/></StackPanel></Grid>
     <TextBlock Text="DISCOVER" FontSize="10" Foreground="#708598" Margin="17,0,0,13" FontWeight="Bold"/>
     <Button x:Name="ServersNav" Style="{StaticResource Nav}" Content="◈    Server directory" Tag="servers" Click="Navigate"/>
     <Button x:Name="DiscordNav" Style="{StaticResource Nav}" Content="◉    Discord communities" Tag="discord" Click="Navigate"/>
     <Button x:Name="FavoritesNav" Style="{StaticResource Nav}" Content="☆    Saved servers" Tag="favorites" Click="Navigate"/>
     <Border Height="1" Background="#26323F" Margin="12,23"/>
     <TextBlock Text="YOUR ATLAS" FontSize="10" Foreground="#708598" Margin="17,0,0,13" FontWeight="Bold"/>
     <Button x:Name="SourcesNav" Style="{StaticResource Nav}" Content="⊞    Sources &amp; settings" Tag="sources" Click="Navigate"/>
     <Button Style="{StaticResource Nav}" Content="↗    Export results" Click="Export"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="10,0,8,0">
     <Border Background="#172824" CornerRadius="6" Padding="12"><TextBlock Text="●  Public sources only" Foreground="#8ACBB0" FontSize="12"/></Border>
     <TextBlock Text="An independent community directory. Explore, compare, and find your people." Foreground="#8094A5" FontSize="12" Margin="0,15,0,14" LineHeight="19"/>
     <TextBlock Text="VERSION 1.1  /  WINDOWS" Foreground="#536A7F" FontSize="10"/>
    </StackPanel>
    <Grid/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,25,30,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="THE SILKROAD COMMUNITY, IN ONE PLACE" Foreground="#8AA0B3" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="TopSubtitle" Text="Public listings • source-linked discovery" Foreground="#C6D0D9" FontSize="13" Margin="0,6,0,0"/></StackPanel>
    <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel" Visibility="Collapsed" Margin="0,0,10,0"/>
    <Button x:Name="RefreshButton" Grid.Column="2" Content="↻  Refresh sources" Style="{StaticResource Primary}" Click="RefreshClick"/>
   </Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="DirectoryPage">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="#18242B" BorderBrush="#304047" BorderThickness="1" CornerRadius="12" Padding="25,21" Margin="0,0,0,22">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="YOUR NEXT CHAPTER" Foreground="#EFC078" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="Find your next Silkroad adventure." FontSize="29" FontWeight="SemiBold" Margin="0,7,0,10"/><TextBlock x:Name="PageDescription" Text="Explore private servers and the communities behind them." Foreground="#A6B7C4" FontSize="13"/></StackPanel>
       <Grid Grid.Column="1" Margin="20,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ServerCount" Text="0" FontSize="34" FontWeight="SemiBold" Foreground="#EFC078"/><TextBlock Text="servers listed" FontSize="11" Foreground="#A6B7C4"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="DiscordCount" Text="0" FontSize="34" FontWeight="SemiBold" Foreground="#B9B9FA"/><TextBlock Text="Discord links" FontSize="11" Foreground="#A6B7C4"/></StackPanel></Grid>
      </Grid>
     </Border>
     <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="133"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" ToolTip="Search server names, websites, caps, rates, or sources" TextChanged="FilterChanged" Margin="0,0,10,0" AutomationProperties.Name="Search servers"/>
      <ComboBox x:Name="CapFilter" Grid.Column="1" SelectionChanged="FilterChanged" Margin="0,0,10,0" AutomationProperties.Name="Level cap"/>
      <ComboBox x:Name="RaceFilter" Grid.Column="2" SelectionChanged="FilterChanged" Margin="0,0,10,0" AutomationProperties.Name="Race"><ComboBoxItem Content="All races"/><ComboBoxItem Content="CH"/><ComboBoxItem Content="EU"/><ComboBoxItem Content="CH + EU"/></ComboBox>
      <ComboBox x:Name="SortFilter" Grid.Column="3" SelectionChanged="FilterChanged" AutomationProperties.Name="Sort order"><ComboBoxItem Content="Name A–Z"/><ComboBoxItem Content="Recently listed"/><ComboBoxItem Content="Most sources"/></ComboBox>
     </Grid>
     <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ResultCount" Text="Browse the catalog" Foreground="#8FA5B7" VerticalAlignment="Center" FontSize="12"/>
      <CheckBox x:Name="DiscordOnly" Grid.Column="1" Content="Has Discord" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,0,20,0"/>
      <Button Grid.Column="2" Content="Reset filters" Style="{StaticResource Link}" Click="ResetFilters" FontSize="12"/>
     </Grid>
     <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="335"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,18,0">
       <ListBox x:Name="ServerList" SelectionChanged="SelectServer" AutomationProperties.Name="Server results">
        <ListBox.ItemTemplate><DataTemplate><Grid Margin="16,15"><Grid.ColumnDefinitions><ColumnDefinition Width="49"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
         <Border Background="#263643" CornerRadius="8" Width="38" Height="42" VerticalAlignment="Top"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EFC078" FontWeight="SemiBold" FontSize="15"/></Border>
         <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="#8FA5B7" Margin="0,5,0,0"/><TextBlock Text="{Binding DiscordLabel}" Foreground="#B8B7F3" FontSize="11" Margin="0,9,0,0"/></StackPanel>
         <StackPanel Grid.Column="2" Margin="0,3,0,0"><TextBlock Text="{Binding CapLabel}" Foreground="#E8C491" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding RaceLabel}" Foreground="#A6B7C4" FontSize="11" Margin="0,6,0,0"/></StackPanel>
         <Button Grid.Column="3" Content="{Binding Star}" Tag="{Binding}" Style="{StaticResource Link}" Click="FavoriteClick" FontSize="23" VerticalAlignment="Top" ToolTip="Save or unsave server"/>
        </Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="EmptyState" Text="No servers match your filters.&#10;Try another name or reset the filters." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AAAB9" TextAlignment="Center" LineHeight="26"/>
      </Grid>
      <Border Grid.Column="1" Background="#121A23" BorderBrush="#26323F" BorderThickness="1" CornerRadius="10">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="21">
        <TextBlock Text="SERVER DETAILS" Foreground="#718A9E" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,16"/>
        <TextBlock x:Name="DetailName" Text="Choose a server" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="DetailSeen" Text="Select a listing to explore its sources and community." Foreground="#8FA5B7" FontSize="11" Margin="0,10,0,20" LineHeight="18"/>
        <TextBlock x:Name="DetailFacts" Foreground="#D8E1E9" LineHeight="25"/>
        <Button x:Name="VisitButton" Content="Visit server website  ↗" Click="VisitWebsite" Margin="0,17,0,0" IsEnabled="False" HorizontalContentAlignment="Center"/>
        <TextBlock x:Name="DetailWebsite" Foreground="#718A9E" FontSize="10" Margin="0,7,0,16"/>
        <Border Height="1" Background="#26323F" Margin="0,0,0,19"/>
        <TextBlock Text="DISCORD COMMUNITIES" Foreground="#918FCA" FontSize="10" FontWeight="Bold"/>
        <ItemsControl x:Name="DetailDiscord" Margin="0,10,0,5"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><Button Content="{Binding Name}" Tag="{Binding Url}" Style="{StaticResource Link}" Foreground="#C2BFFC" Click="OpenLink" ToolTip="{Binding Url}"/><TextBlock Text="{Binding CheckedLabel}" Foreground="#8FA5B7" FontSize="11"/><TextBlock Text="{Binding Url}" FontSize="10" Foreground="#718A9E"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Button x:Name="ScanButton" Content="Find Discord on website" Click="ScanWebsite" FontSize="12" IsEnabled="False" Margin="0,0,0,20"/>
        <TextBlock Text="SOURCE EVIDENCE" Foreground="#718A9E" FontSize="10" FontWeight="Bold"/>
        <ItemsControl x:Name="EvidenceList" Margin="0,9,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,13"><Button Content="{Binding Label}" Tag="{Binding Url}" Style="{StaticResource Link}" Click="OpenLink" FontSize="11"/><TextBlock Text="{Binding Facts}" Foreground="#A6B7C4" FontSize="11"/><TextBlock Text="{Binding Title}" Foreground="#718A9E" FontSize="10" Margin="0,4,0,0" MaxHeight="50" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="Listings are source reports, not confirmation that a game server is online. Conflicting caps are shown together." Foreground="#718A9E" FontSize="11" LineHeight="18" Margin="0,12,0,0"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
    </Grid>
    <Grid x:Name="CommunitiesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,22"><TextBlock Text="Find your people." FontSize="33" FontWeight="SemiBold"/><TextBlock Text="Public Discord invites discovered alongside Silkroad server listings." Foreground="#9AAAB9" Margin="0,10,0,0"/><TextBlock Text="Check invites to load community icons and approximate Discord member counts. Private channels are not indexed." Foreground="#778EA1" FontSize="12" Margin="0,7,0,0"/></StackPanel>
     <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CommunitySearch" TextChanged="CommunityFilterChanged" Margin="0,0,14,0" AutomationProperties.Name="Search Discord communities" ToolTip="Search Discord communities"/><Button x:Name="VerifyButton" Grid.Column="1" Content="Check invites &amp; load icons" Click="VerifyDiscord" Style="{StaticResource Primary}"/></Grid>
     <ListBox x:Name="CommunityList" Grid.Row="2" AutomationProperties.Name="Discord community results"><ListBox.ItemTemplate><DataTemplate>
      <Grid Margin="18,15"><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
       <Border Background="#2C2F52" CornerRadius="12" Height="50" Width="50" VerticalAlignment="Top"><Grid><TextBlock Text="◉" Foreground="#BEBBFF" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Width="50" Height="50"/></Grid></Border>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Community.Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding ServerName}" Foreground="#8FA5B7" FontSize="12" Margin="0,4,0,0"/><TextBlock Text="{Binding Community.CountLabel}" Foreground="#B6B4EE" Margin="0,8,0,0" FontSize="12"/><TextBlock Text="{Binding Community.CheckedLabel}" Foreground="#778EA1" FontSize="11" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="10,0,0,0"><Button Content="Open Discord  ↗" Tag="{Binding Community.Url}" Click="OpenLink" Background="#464690" BorderBrush="#6663A9"/><Button Content="View discovery source" Tag="{Binding Community.SourceUrl}" Click="OpenLink" Style="{StaticResource Link}" HorizontalAlignment="Center" FontSize="11" Margin="0,7,0,0"/></StackPanel>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
    <ScrollViewer x:Name="SourcesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Every listing has a source." FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Choose where Atlas looks. Your saved catalog stays available offline." Foreground="#9AAAB9" Margin="0,10,0,12"/>
     <TextBlock x:Name="SourceSummary" Foreground="#EFC078" FontSize="12" Margin="0,0,0,12"/>
     <TextBlock Text="Search sources by name or language" Foreground="#819BAD" FontSize="12" Margin="0,0,0,6"/>
     <TextBox x:Name="SourceSearch" TextChanged="SourceSearchChanged" AutomationProperties.Name="Search sources" Margin="0,0,0,18"/>
     <ItemsControl x:Name="SourceList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#131B24" BorderBrush="#26323F" BorderThickness="1" CornerRadius="9" Padding="20" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
      <CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding CanCrawl}" Tag="{Binding}" Click="SourceToggle" ToolTip="Enable this source"/>
      <StackPanel Grid.Column="1" Margin="0,0,15,0"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceInfo}" Foreground="#9AAAB9" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="{Binding Url}" Foreground="#819BAD" FontSize="12" Margin="0,5,0,9"/><TextBlock Text="{Binding Status}" Foreground="#E0B97D" FontSize="12"/><TextBlock Text="{Binding CheckedLabel}" Foreground="#718A9E" FontSize="11" Margin="0,5,0,0"/><Button Content="Show imported listings →" Tag="{Binding}" Click="ShowSourceListings" Style="{StaticResource Link}" IsEnabled="{Binding CanCrawl}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><Button Content="Open  ↗" Tag="{Binding Url}" Click="OpenLink" FontSize="12"/><Button Content="Refresh" Tag="{Binding}" Click="RefreshSource" IsEnabled="{Binding CanCrawl}" FontSize="12" Margin="0,7,0,0"/><Button Content="Remove" Tag="{Binding}" Click="RemoveSource" Style="{StaticResource Link}" Foreground="#A3ABB5" HorizontalAlignment="Center" FontSize="11" Margin="0,9,0,0"/></StackPanel>
     </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button x:Name="AddSourceButton" Content="+  Add server website or forum" Click="AddSource" HorizontalAlignment="Left" Margin="0,5,0,25"/>
     <Border Background="#151F29" CornerRadius="9" Padding="22"><StackPanel><TextBlock Text="Refresh settings" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Directory pages per source"/><TextBlock Text="Increase for a broader sweep, including older listings." Foreground="#819BAD" FontSize="12" Margin="0,4,0,0"/></StackPanel><ComboBox x:Name="PageLimitBox" Grid.Column="1" SelectionChanged="SettingsChanged"><ComboBoxItem Content="5 pages" Tag="5"/><ComboBoxItem Content="15 pages" Tag="15"/><ComboBoxItem Content="40 pages" Tag="40"/><ComboBoxItem Content="100 pages" Tag="100"/></ComboBox></Grid><CheckBox x:Name="AutoRefreshBox" Content="Refresh every hour while the app is open" Click="SettingsChanged"/><TextBlock Text="Requests are paced, respect robots.txt, and stop at access blocks. Forum enrichment reads up to 12 announcement posts per refresh. Use the website scan to find additional Discord links." Foreground="#819BAD" FontSize="12" LineHeight="20" Margin="0,14,0,0"/></StackPanel></Border>
     <TextBlock Text="Coverage is open-ended: unlisted servers, login-only forums, expired invites, and private Discord channels may be missing. Adding a website includes it as a user-supplied Silkroad source." Foreground="#819BAD" FontSize="12" LineHeight="20" Margin="0,20,0,15"/>
     <Button Content="Export full catalog backup (JSON)" Click="ExportBackup" HorizontalAlignment="Left"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <StackPanel Grid.Row="2" Margin="0,16,0,0"><ProgressBar x:Name="BusyBar" Height="2" IsIndeterminate="True" Visibility="Collapsed" Foreground="#EFC078" Background="#26323F" Margin="0,0,0,9"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="#8FA5B7" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
  </Grid>
 </Grid>
</Window>
